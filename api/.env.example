DATABASE_URL="postgresql://portal:portal@localhost:5433/modmos_portal?schema=public"
# Optional read-only URLs for Admin → Databases viewer
# Local dev (Postgres on host):
GOLD_DATABASE_URL="postgresql://goldagent:password@127.0.0.1:5432/gold_agent?schema=public"
INVESTMENT_DATABASE_URL="postgresql://investment:investment@127.0.0.1:5434/investment?schema=public"
# VPS Portal API in Docker — use host.docker.internal instead of 127.0.0.1 for Gold/Investment
# GOLD_DATABASE_URL="postgresql://goldagent:password@host.docker.internal:5432/gold_agent?schema=public"
# INVESTMENT_DATABASE_URL="postgresql://investment:investment@host.docker.internal:5434/investment?schema=public"
DISCORD_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_MAX_AGE_HOURS=12
FRONTEND_ORIGIN="http://localhost:5173,http://localhost:5174"
COOKIE_SECURE=false
PORT=3001
DEFAULT_ADMIN_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_ADMIN_NAME=Admin
